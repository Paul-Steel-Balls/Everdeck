; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everdeck"
config/version="0.9.3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ArtPacks="*res://scripts/art_packs.gd"
Transition="*res://scripts/ui/transition.gd"
Music="*res://scripts/ui/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; PC build: Forward+ renderer on desktop (needed for the hologram look).
; Sprint 1a: mobile renderer (Vulkan) for the 3D table. The .mobile
; override is set explicitly — without it, Android would use the engine
; default gl_compatibility for the mobile feature tag.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
; Fallback: if a device has no Vulkan, fall back to OpenGL (plainer look,
; still launches). Explicitly true (also the engine default).
rendering_device/fallback_to_opengl3=true
; MSAA 2x for the 3D view (0 = off, 1 = 2x, 2 = 4x, 3 = 8x).
anti_aliasing/quality/msaa_3d=1
; Modest shadow resolution on mobile (one shadow-casting light only).
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
textures/vram_compression/import_etc2_astc=true

[input_devices]

; The game handles touch natively everywhere (Buttons, gui_input drag,
; ScrollContainer). Emulated mouse events would double-deliver every tap
; (touch + synthetic mouse), which double-fired class picks (P2's choice
; consumed by P1's tap) and would double-add deckbuilder cards.
pointing/emulate_mouse_from_touch=false
